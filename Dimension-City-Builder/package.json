{
  "name": "dimension-city-builder",
  "version": "1.0.1",
  "description": "Dimension City Builder - city builder procedural 3D em Three.js",
  "author": "DIGI TECH",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.digitech.dimensioncitybuilder",
    "productName": "Dimension City Builder",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "build" },
    "files": ["index.html", "main.js", "vendor/**/*", "package.json"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Dimension City Builder", "installerLanguages": ["pt_BR"], "language": 1046 }
  }
}
